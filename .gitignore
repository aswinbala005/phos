cat > .gitignore << 'EOF'
# Python / Venv
phos/ __pycache__/ *.pyc .ruff_cache/ .pytest_cache/ uv.lock
# Node/Expo
node_modules/ .pnpm-store/ dist/ .expo/
# Docker/Infra
*.log .env .env.local data/
# Models/Caches
*.pt *.onnx *.bin models/cache/
# OS/IDE
.DS_Store Thumbs.db *.swp .vscode/*
! .vscode/settings.json
EOF